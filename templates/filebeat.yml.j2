filebeat.inputs:
- type: log
  enabled: true
  paths:
    - /var/log/nginx/*.log
    - /var/log/nginx/access.log
    - /var/log/nginx/error.log

filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

# Настройка вывода в Elasticsearch (работает в Docker на хосте elastic)
output.elasticsearch:
  hosts: ["{{ elasticsearch_host }}:9200"]
  # Если безопасность включена в Docker, здесь могут понадобиться логин/пароль
  # username: "elastic"
  # password: "changeme"

processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  - add_cloud_metadata: ~
  - add_docker_metadata: ~
  - add_kubernetes_metadata: ~



